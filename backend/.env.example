# Copy to .env and adjust. main.go reads these via internal/config.
PORT=8080
APP_ENV=development

# Either set DATABASE_URL directly...
# DATABASE_URL=host=localhost port=5432 user=postgres password=postgres dbname=pyramid sslmode=disable

# ...or the discrete parts (used when DATABASE_URL is unset):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pyramid
DB_SSLMODE=disable

# Allowed origin for the Svelte dev server
CORS_ORIGIN=http://localhost:5173
