# Internal router for the Coolify deployment (docker-compose.coolify.yml).
# Coolify's Traefik terminates TLS for pyramid.kimlerdensin.com and forwards
# plain HTTP here; this puts the SPA and the API on one origin (the frontend
# is built with VITE_API_URL="" and calls relative /api/...). Sign-in is the
# app's own (session cookie), so there's no basic auth here any more.
{
	admin off
	auto_https off
}

:80 {
	encode gzip zstd

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
	}

	handle /health {
		reverse_proxy backend:8080
	}

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
